NODE_ENV=development
PORT=3000

MONGO_URI=mongodb://lumen:lumen_dev_pass@localhost:27017/lumen?authSource=admin

JWT_ACCESS_SECRET=change_me_access_secret_32_chars_min
JWT_REFRESH_SECRET=change_me_refresh_secret_32_chars_min
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# S3 / MinIO Configuration
# For local dev with MinIO:
# S3_ENDPOINT=http://localhost:9000
# S3_FORCE_PATH_STYLE=true
#
# For AWS S3 (production / cloud):
# Leave S3_ENDPOINT commented out or blank!
# S3_FORCE_PATH_STYLE=false
S3_REGION=us-east-1
S3_BUCKET=lumen-media
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key
S3_FORCE_PATH_STYLE=false
MEDIA_URL_EXPIRY_SECONDS=3600

# Google OAuth — create credentials at https://console.cloud.google.com/
# Use the Web Application client ID here (used for server-side id_token verification)
GOOGLE_CLIENT_ID=

# Optional: Expo push notifications
EXPO_PUSH_TOKEN=

# Optional: weather API (OpenWeatherMap)
WEATHER_API_KEY=

# Optional: Redis for BullMQ job queue
REDIS_URL=redis://localhost:6379
